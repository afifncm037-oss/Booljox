--========================================================--
-- HELPERS
--========================================================--

local function Clamp(
value,
minimum,
maximum
)

return math.clamp(  
    tonumber(value) or minimum,  
    minimum,  
    maximum  
)

end

local function FormatTime(seconds)

seconds =  
    tonumber(seconds) or 0  

seconds =  
    math.max(seconds, 0)  

local minutes =  
    math.floor(seconds / 60)  

local secs =  
    math.floor(seconds % 60)  

return string.format(  
    "%02d:%02d",  
    minutes,  
    secs  
)

end

local function SafeString(
value,
fallback
)

if value == nil then  
    return fallback or ""  
end  

local success, result =  
    pcall(function()  
        return tostring(value)  
    end)  

if not success  
    or result == "" then  

    return fallback or ""  

end  

return result

end

local function GetNumber(value)

return tonumber(value) or 0

end

local function GetAudioID(audio)

if not audio then  
    return nil  
end  

local id  

pcall(function()  
    id = audio.Id  
end)  

if id then  
    return tostring(id)  
end  

return nil

end

local function GetAudioTitle(audio)

if not audio then  
    return "Unknown Title"  
end  

return SafeString(  
    audio.Title,  
    "Unknown Title"  
)

end

local function GetAudioArtist(audio)

if not audio then  
    return "Unknown Artist"  
end  

return SafeString(  
    audio.Artist,  
    "Unknown Artist"  
)

end

local function GetAudioDuration(audio)

if not audio then  
    return 0  
end  

return GetNumber(  
    audio.Duration  
)

end

local function BuildAudioName(audio)

return string.format(  
    "%s • %s • %s • ID %s",  

    GetAudioTitle(audio),  

    GetAudioArtist(audio),  

    FormatTime(  
        GetAudioDuration(audio)  
    ),  

    tostring(  
        GetAudioID(audio)  
    )  
)

end

