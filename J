--========================================================--

Sound.Ended:Connect(
function()

if Closing then  
        return  
    end  

    if LoopEnabled then  
        return  
    end  

    if #Queue > 0 then  

        task.defer(  
            function()  

                if not Closing then  
                    PlayNextSong()  
                end  

            end  
        )  

    else  

        CurrentID = nil  

        CurrentTitle =  
            "Nothing Playing"  

        CurrentArtist =  
            "Unknown Artist"  

        CurrentDuration = 0  

        CurrentQueueSong = nil  
        PlayingFromQueue = false  

        StopProgressUpdater()  

        UpdateStatus()  

    end  

end

