--========================================================--
-- PLAY AUDIO
--========================================================--

local function PlayAudio(
audio,
fromQueue
)

if Closing then  
    return false  
end  

if not audio then  
    return false  
end  

local id =  
    GetAudioID(audio)  

if not id  
    or id == "" then  

    Notify(  
        "ROXO BOOMBOX",  
        "Invalid or missing audio ID.",  
        4  
    )  

    return false  
end  

CurrentID = id  

CurrentTitle =  
    GetAudioTitle(audio)  

CurrentArtist =  
    GetAudioArtist(audio)  

CurrentDuration =  
    GetAudioDuration(audio)  

CurrentQueueSong =  
    audio  

PlayingFromQueue =  
    fromQueue == true  

if LoadedConnection then  

    pcall(function()  
        LoadedConnection:Disconnect()  
    end)  

    LoadedConnection = nil  

end  

pcall(function()  
    Sound:Stop()  
end)  

Sound.SoundId =  
    "rbxassetid://"  
    .. tostring(id)  

-- 5000% control.  
--  
-- Roblox's audio system does not guarantee that  
-- "5000%" produces 50x perceived loudness on every  
-- device. The control stores the requested value,  
-- while the engine is protected from extreme values.  

Sound.Volume =  
    math.clamp(  
        Volume / 100,  
        0,  
        50  
    )  

Sound.Looped =  
    LoopEnabled  

ApplyAudioEffects()  

UpdateStatus()  

StartProgressUpdater()  

local loadFinished = false  

LoadedConnection =  
    Sound.Loaded:Connect(  
        function()  

            loadFinished = true  

            if LoadedConnection then  

                pcall(function()  
                    LoadedConnection:Disconnect()  
                end)  

                LoadedConnection = nil  

            end  

            if Closing then  
                return  
            end  

            CurrentDuration =  
                Sound.TimeLength  

            UpdateStatus()  

        end  
    )  

local success, errorMessage =  
    pcall(function()  

        Sound:Play()  

    end)  

if not success then  

    Notify(  
        "Playback Error",  
        SafeString(  
            errorMessage,  
            "Unable to play audio."  
        ),  
        5  
    )  

    return false  
end  

task.delay(  
    8,  
    function()  

        if Closing then  
            return  
        end  

        if not loadFinished  
            and Sound.Parent  
            and Sound.SoundId ==  
                "rbxassetid://" .. tostring(id) then  

            pcall(function()  
                Sound:Play()  
            end)  

        end  

    end  
)  

Notify(  
    "🎵 Now Playing",  
    CurrentTitle  
    .. " • "  
    .. CurrentArtist,  
    3  
)  

return true

end

