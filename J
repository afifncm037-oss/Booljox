--========================================================--
-- SLOWED + REVERB OVERHAUL
--========================================================--

local function ApplySlowedReverb()

if PeacefulEnabled then  
    return  
end  

if not RecommendedSlowed  
    and not CustomSlowed then  

    Sound.PlaybackSpeed =  
        Clamp(  
            NormalSpeed,  
            MIN_SPEED,  
            MAX_SPEED  
        )  

    return  
end  

Reverb.Enabled = true  

if RecommendedSlowed then  

    -- Roblox PlaybackSpeed also changes pitch.  
    -- This is kept controlled rather than pretending  
    -- Roblox provides native pitch-preserving  
    -- time-stretching.  

    Sound.PlaybackSpeed =  
        Clamp(  
            NormalSpeed * 0.78,  
            MIN_SPEED,  
            MAX_SPEED  
        )  

    Reverb.DecayTime = 4.2  
    Reverb.Density = 0.72  
    Reverb.Diffusion = 0.92  
    Reverb.DryLevel = -1  
    Reverb.WetLevel = -4  

elseif CustomSlowed then  

    local slow =  
        Clamp(  
            CustomSlowAmount,  
            0,  
            50  
        ) / 100  

    local reverb =  
        Clamp(  
            CustomReverbAmount,  
            0,  
            100  
        ) / 100  

    Sound.PlaybackSpeed =  
        Clamp(  
            NormalSpeed * (1 - slow),  
            MIN_SPEED,  
            MAX_SPEED  
        )  

    Reverb.DecayTime =  
        1.8 + (4.2 * reverb)  

    Reverb.Density =  
        0.3 + (0.5 * reverb)  

    Reverb.Diffusion =  
        0.5 + (0.45 * reverb)  

    Reverb.DryLevel = -1  

    Reverb.WetLevel =  
        -16 + (12 * reverb)  

end

end

