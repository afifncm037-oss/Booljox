local QueueDropdown

local function BuildQueueOptions()

local options = {}  

for index, song in ipairs(Queue) do  

    table.insert(  
        options,  

        string.format(  
            "%02d. %s • %s • ID %s",  

            index,  

            GetAudioTitle(song),  

            GetAudioArtist(song),  

            tostring(  
                GetAudioID(song)  
            )  
        )  
    )  

end  

if #options == 0 then  

    table.insert(  
        options,  
        "Queue is empty"  
    )  

end  

return options

end

local function RefreshQueueDropdown()

if not QueueDropdown then  
    return  
end  

pcall(function()  

    QueueDropdown:Refresh(  
        BuildQueueOptions()  
    )  

    QueueDropdown:Set({})  

end)  

SelectedQueueIndex = nil

end

--========================================================--
-- NEXT SONG
--========================================================--

local function PlayNextSong()

if Closing then  
    return  
end  

if #Queue == 0 then  

    Notify(  
        "Queue",  
        "No songs left in the queue.",  
        3  
    )  

    return  
end  

local nextSong =  
    table.remove(  
        Queue,  
        1  
    )  

RefreshQueueDropdown()  

if nextSong then  

    PlayAudio(  
        nextSong,  
        true  
    )  

end

end

